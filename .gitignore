# Example data.
#
# The raw NetCDF files are NOT committed: they are downloaded on first use
# from the Zenodo archive (DOI 10.5281/zenodo.20361229) and cached in
# _data/, with md5 verification (see _data/__init__.py). So ignore every
# .nc in _data/ ...
_data/*.nc

# ... EXCEPT the small committed derived data product: the spatial-mean slope
# time series for the full 60 s record, precomputed once from the full stack
# (reduce every frame with pss.compute_slope_field, then average spatially)
# and consumed by _data/__init__.py:mean_wave_timeseries() to reconstruct
# eta_long(t) offline.
!_data/asit2019_mean_slope_60s.nc

# ... and the committed independent-validation file: the Riegl LD90-3
# water-surface elevation series, packaged once from the raw elevation array
# (6000 samples at 10 Hz, t=0 at acquisition start).
!_data/asit2019_lidar_elevation_10min.nc

# ... and the small committed dual-camera demo data products (Piermont 2025),
# central-column uint16 mean frames produced once by
# _examples/convert_piermont_dualcam.py: the LDEO 5 mm wide DoLP-AOI
# calibration frame and the UNH 75 mm narrow multi-angle stack.
!_data/piermont2025_ldeo_wide_5mm_mean.nc
!_data/piermont2025_unh_narrow_75mm_stack.nc

# Python build / cache files
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
build/
dist/
*.part

# Ignore the contents of _dustbin/
_dustbin/*

# Virtual environment, editor, and tooling directories
.venv
.vscode
.claude

# Jupyter editor caches
.virtual_documents/
.ipynb_checkpoints/
